DATABASE_URL=postgresql://postgres:password@localhost:5432/veloxpay
JWT_SECRET=change-this-to-a-long-random-string
PORT=4001

# 32-byte key, hex-encoded (64 hex characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts bank account numbers at rest. Losing this key makes existing encrypted
# data unrecoverable — back it up like any other production secret.
ENCRYPTION_KEY=change-this-to-a-64-char-hex-string

# CORS: comma-separated list of allowed frontend origins. Leave unset in local dev
# to allow all origins; set explicitly in any deployed environment.
ALLOWED_ORIGINS=

# Optional — leave SMTP_HOST empty to skip real email delivery (notifications are
# still logged, just marked "skipped" instead of pretending to send).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VeloxPay <no-reply@veloxpay.local>
